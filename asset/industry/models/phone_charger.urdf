<?xml version="1.0"?>
<robot name="phone_charger">

  <material name="white">
    <color rgba="0.95 0.95 0.95 1"/>
  </material>
  <material name="metal">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <!-- 充电器本体 -->
  <link name="charger_body">
    <visual>
      <geometry><box size="0.05 0.03 0.06"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.03 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 插脚（左） -->
  <link name="pin_1">
    <visual>
      <geometry><box size="0.001 0.006 0.015"/></geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <geometry><box size="0.001 0.002 0.013"/></geometry>
    </collision>
  </link>

  <joint name="pin_1_joint" type="fixed">
    <parent link="charger_body"/>
    <child link="pin_1"/>
    <origin xyz="-0.0075 0 0.0365"/>
  </joint>

  <!-- 插脚（右） -->
  <link name="pin_2">
    <visual>
      <geometry><box size="0.001 0.006 0.015"/></geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <geometry><box size="0.001 0.002 0.013"/></geometry>
    </collision>
  </link>

  <joint name="pin_2_joint" type="fixed">
    <parent link="charger_body"/>
    <child link="pin_2"/>
    <origin xyz="0.0075 0 0.0365"/>
  </joint>

</robot>


